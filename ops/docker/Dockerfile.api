FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY services/api/package.json services/api/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY services/api services/api
RUN pnpm --filter @sg/shared build && pnpm --filter @sg/api build

FROM node:22-bookworm-slim AS production-dependencies

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY --from=build /workspace/packages/shared packages/shared
COPY --from=build /workspace/services/api/package.json services/api/package.json
COPY --from=build /workspace/services/api/dist services/api/dist
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm --filter @sg/api... install --prod --frozen-lockfile --ignore-scripts

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PORT=18080
WORKDIR /app

COPY --from=production-dependencies --chown=node:node /workspace ./

USER node
EXPOSE 18080

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:18080/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "services/api/dist/index.js"]
