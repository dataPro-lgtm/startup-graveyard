# ========= 当前 API / Web 本地开发会用到 =========
NODE_ENV=development
PORT=18080
# 生产编排按进程设置 api / worker / scheduler；本地默认 api。
SG_RUNTIME_ROLE=api
# worker 默认 18081，scheduler 默认 18082；通常无需手动覆盖。
# RUNTIME_HEALTH_PORT=18080
# 与本仓库 docker-compose / Makefile 保持一致：
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sg
WEB_BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:18080
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:18080
# 浏览器来源精确白名单；WEB_BASE_URL 会自动加入，多来源使用英文逗号分隔。
CORS_ALLOWED_ORIGINS=
# 仅当 API 位于可信反向代理后方时配置，例如 127.0.0.1,10.0.0.0/8。
TRUST_PROXY=false
# 生产环境强制开启。默认窗口 60 秒，各阈值可按容量调整。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_REFRESH_MAX=30
RATE_LIMIT_COPILOT_MAX=20
RATE_LIMIT_EXPORT_MAX=10
RATE_LIMIT_BILLING_MAX=10
RATE_LIMIT_WEBHOOK_MAX=120
# 仅供非浏览器自动化的过渡 service principal；Admin Web 使用具名用户会话。
ADMIN_API_KEY=

# JWT 签名密钥 — 生产环境务必设置随机值: openssl rand -base64 48
JWT_SECRET=change-me-in-production
# 生产公网必须为 true；仅 loopback 本地验收可关闭。
AUTH_COOKIE_SECURE=false
# 跨站部署可设 none，但必须同时启用 Secure；同站子域默认 lax。
AUTH_COOKIE_SAME_SITE=lax

# 列表「q」相关度：可选混合向量排序（无 key 则仅 pg_trgm）
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Copilot Q&A：OpenAI chat 模型（默认 gpt-4o-mini）
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_CHAT_INPUT_COST_PER_1K=0.00015
# OPENAI_CHAT_OUTPUT_COST_PER_1K=0.0006

# Copilot Q&A：Anthropic Claude（优先于 OpenAI chat）
ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_CHAT_INPUT_COST_PER_1K=0.0008
# ANTHROPIC_CHAT_OUTPUT_COST_PER_1K=0.004
OPENSEARCH_URL=http://localhost:9200
TEMPORAL_ADDRESS=localhost:7233
# 生产默认开启，测试默认关闭。metrics 使用独立端口：api 9464 / worker 9465 / scheduler 9466。
# OBSERVABILITY_ENABLED=true
# OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
# OTEL_EXPORTER_PROMETHEUS_PORT=9464
# OTEL_EXPORTER_PROMETHEUS_PATH=/metrics
# 配置后启用 OTLP traces；推荐指向 OpenTelemetry Collector。
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# RELEASE_VERSION=1.3.0

# 平台告警自动投递：定时 snapshot 后按 code/channel 持久化去重。
PLATFORM_ALERT_COOLDOWN_MINUTES=60
PLATFORM_ALERT_RETRY_MINUTES=5
PLATFORM_ALERT_TIMEOUT_MS=10000
PLATFORM_ALERT_WEBHOOK_URL=
PLATFORM_ALERT_WEBHOOK_BEARER_TOKEN=
PLATFORM_ALERT_SLACK_WEBHOOK_URL=

# 定价页展示价格（仅展示用途；实际扣款以 Stripe Price 为准）
# NEXT_PUBLIC_PRO_PRICE_LABEL=US$19
# NEXT_PUBLIC_TEAM_PRICE_LABEL=US$99

# Stripe 订阅结账：支持 Pro / Team
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# 认证事务邮件（密码重置）。留空时自动复用下方 TEAM_WORKSPACE_RECOVERY_EMAIL_* SMTP 配置。
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=
AUTH_EMAIL_SMTP_SECURE=
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASS=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=
AUTH_EMAIL_TIMEOUT_MS=10000
# 密码重置链接有效期（分钟，最小 5）
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# 邮箱验证链接有效期（分钟，最小 30，默认 24 小时）
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440

# Team Workspace 恢复外部交接：owner 恢复邮件 + CRM / webhook / Slack handoff
TEAM_WORKSPACE_RECOVERY_EMAIL_SMTP_HOST=
TEAM_WORKSPACE_RECOVERY_EMAIL_SMTP_PORT=587
TEAM_WORKSPACE_RECOVERY_EMAIL_SMTP_SECURE=false
TEAM_WORKSPACE_RECOVERY_EMAIL_SMTP_USER=
TEAM_WORKSPACE_RECOVERY_EMAIL_SMTP_PASS=
TEAM_WORKSPACE_RECOVERY_EMAIL_FROM=
TEAM_WORKSPACE_RECOVERY_EMAIL_REPLY_TO=
TEAM_WORKSPACE_RECOVERY_EMAIL_TIMEOUT_MS=10000
TEAM_WORKSPACE_RECOVERY_WEBHOOK_URL=
TEAM_WORKSPACE_RECOVERY_WEBHOOK_BEARER_TOKEN=
TEAM_WORKSPACE_RECOVERY_WEBHOOK_TIMEOUT_MS=10000
TEAM_WORKSPACE_RECOVERY_WEBHOOK_MAX_ATTEMPTS=3
TEAM_WORKSPACE_RECOVERY_SLACK_WEBHOOK_URL=
TEAM_WORKSPACE_RECOVERY_SLACK_WEBHOOK_TIMEOUT_MS=10000
TEAM_WORKSPACE_RECOVERY_CRM_API_URL=
TEAM_WORKSPACE_RECOVERY_CRM_API_BEARER_TOKEN=
TEAM_WORKSPACE_RECOVERY_CRM_API_TIMEOUT_MS=10000
